{
  "name": "n8n-nodes-nats-jetstream",
  "version": "0.1.2",
  "description": "NATS JetStream community nodes for n8n: durable pull consumer trigger, confirmed JSON/text/binary publishing, native authentication and verified TLS",
  "license": "MIT",
  "homepage": "https://github.com/digows/n8n-nodes-nats-jetstream",
  "keywords": ["n8n-community-node-package", "n8n", "n8n-nodes", "n8n-community-nodes", "nats", "nats-jetstream", "jetstream", "messaging", "durable-consumer", "message-queue", "workflow-automation", "event-driven", "typescript", "tls"],
  "author": { "name": "Rodrigo P. Fraga", "email": "rodrigo.p.fraga@gmail.com" },
  "repository": { "type": "git", "url": "git+https://github.com/digows/n8n-nodes-nats-jetstream.git" },
  "bugs": { "url": "https://github.com/digows/n8n-nodes-nats-jetstream/issues" },
  "engines": { "node": ">=24" },
  "files": ["dist", "README.md", "LICENSE", "docs", "CONTRIBUTING.md"],
  "scripts": {
    "build": "n8n-node build",
    "lint": "n8n-node lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.cjs",
    "test:broker": "node --test --test-concurrency=1 tests/broker/*.test.cjs",
    "test:host": "node --test --test-concurrency=1 tests/host/*.test.cjs",
    "check": "npm run build && npm run lint && npm run typecheck && npm test"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/NatsJetstreamApi.credentials.js"],
    "nodes": ["dist/nodes/NatsJetstream/NatsJetstream.node.js", "dist/nodes/NatsJetstream/NatsJetstreamTrigger.node.js"]
  },
  "dependencies": { "@nats-io/jetstream": "3.4.0", "@nats-io/transport-node": "3.4.0" },
  "peerDependencies": { "n8n-workflow": "*" },
  "devDependencies": {
    "@n8n/node-cli": "0.51.4",
    "@types/node": "24.10.0",
    "flatted": "3.4.2",
    "n8n-workflow": "2.42.2",
    "typescript": "5.9.3"
  }
}
